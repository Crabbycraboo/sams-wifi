<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .login-container {
      max-width: 600px;
      margin: 60px auto 20px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 16px;
      padding: 40px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .login-title {
      text-align: center;
      margin-bottom: 30px;
    }

    .login-title h1 {
      font-size: 32px;
      margin: 0;
      color: white;
    }

    .login-subtitle {
      font-size: 14px;
      color: rgba(255,255,255,0.8);
      margin-top: 8px;
    }

    .plans-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      margin-bottom: 30px;
    }

    .plan-card {
      background: rgba(255,255,255,0.15);
      border: 2px solid rgba(255,255,255,0.3);
      border-radius: 12px;
      padding: 16px;
      text-align: center;
      cursor: pointer;
      transition: all 0.3s;
      color: white;
    }

    .plan-card:hover {
      background: rgba(255,255,255,0.25);
      border-color: rgba(255,255,255,0.6);
      transform: translateY(-2px);
    }

    .plan-card.active {
      background: rgba(255,255,255,0.3);
      border-color: white;
      box-shadow: 0 4px 15px rgba(255,255,255,0.2);
    }

    .plan-price {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 4px;
    }

    .plan-duration {
      font-size: 12px;
      opacity: 0.9;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-size: 14px;
      color: rgba(255,255,255,0.9);
      margin-bottom: 8px;
      font-weight: 500;
    }

    .form-input {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-family: 'JetBrains Mono', monospace;
      background: rgba(255,255,255,0.95);
      color: #333;
      box-sizing: border-box;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .form-input::placeholder {
      color: #999;
    }

    .btn-connect {
      width: 100%;
      padding: 14px;
      background: white;
      color: #667eea;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
    }

    .btn-connect:hover {
      background: #f0f0f0;
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(255,255,255,0.3);
    }

    .error-alert {
      background: #ff6b6b;
      color: white;
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 14px;
    }

    .gcash-section {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 12px;
      padding: 16px;
      margin-top: 24px;
      text-align: center;
      color: rgba(255,255,255,0.9);
    }

    .gcash-label {
      font-size: 12px;
      text-transform: uppercase;
      opacity: 0.8;
      margin-bottom: 8px;
    }

    .gcash-number {
      font-size: 20px;
      font-weight: bold;
      font-family: 'JetBrains Mono', monospace;
      margin: 8px 0;
    }

    .gcash-name {
      font-size: 13px;
      opacity: 0.85;
    }

    .hint {
      font-size: 12px;
      color: rgba(255,255,255,0.8);
      margin-top: 12px;
      text-align: center;
    }
  </style>
</head>
<body style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; margin: 0;">

  <div class="login-container">
    <div class="login-title">
      <h1>📶 Sam's WiFi</h1>
      <p class="login-subtitle">Voucher Code Required</p>
    </div>

    <% if (error) { %>
      <div class="error-alert">⚠️ <%= error %></div>
    <% } %>

    <div style="margin-bottom: 20px;">
      <p style="color: rgba(255,255,255,0.9); font-size: 14px; text-align: center; margin: 0 0 16px 0;">
        <% if (sleepMode) { %>
          😴 Sleep Mode: Pay via GCash & message for code
        <% } else { %>
          Choose your plan & enter voucher code
        <% } %>
      </p>
    </div>

    <form method="POST" action="/connect">
      <!-- Plans Display -->
      <div class="plans-grid">
        <% plans.forEach(plan => { %>
          <div class="plan-card <%= code === plan.name ? 'active' : '' %>">
            <div class="plan-price"><%= plan.name.split(' / ')[0] %></div>
            <div class="plan-duration"><%= plan.name.split(' / ')[1] %></div>
          </div>
        <% }) %>
      </div>

      <!-- Voucher Code Input -->
      <div class="form-group">
        <label class="form-label">Voucher Code</label>
        <input 
          type="text" 
          name="code" 
          class="form-input" 
          placeholder="SAM-XXXX"
          value="<%= code %>"
          maxlength="8"
          required
          autocomplete="off"
        >
        <div class="hint">Format: SAM-XXXX (found on your voucher slip)</div>
      </div>

      <!-- Connect Button -->
      <button type="submit" class="btn-connect">🔗 Connect</button>
    </form>

    <!-- GCash Section -->
    <div class="gcash-section">
      <div class="gcash-label">💳 Don't have a code?</div>
      <div class="gcash-label" style="opacity: 1; font-weight: 600; margin-bottom: 12px;">Pay via GCash</div>
      <div class="gcash-number"><%= gcash.number %></div>
      <div class="gcash-name"><%= gcash.name %></div>
      <div style="font-size: 12px; margin-top: 12px; opacity: 0.85;">
        Send payment + message for your code
      </div>
    </div>
  </div>

</body>
</html>
