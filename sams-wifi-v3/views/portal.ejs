<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .dashboard {
      max-width: 500px;
      margin: 60px auto 20px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 16px;
      padding: 40px 30px;
      color: white;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    .dashboard h1 {
      font-size: 14px;
      font-weight: 500;
      opacity: 0.9;
      margin-bottom: 20px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .time-display {
      font-size: 48px;
      font-weight: bold;
      margin: 20px 0;
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 2px;
    }
    .plan-info {
      display: flex;
      justify-content: space-around;
      margin: 30px 0;
      padding: 20px 0;
      border-top: 1px solid rgba(255,255,255,0.2);
      border-bottom: 1px solid rgba(255,255,255,0.2);
    }
    .plan-info div {
      flex: 1;
    }
    .plan-info label {
      font-size: 12px;
      opacity: 0.8;
      display: block;
      margin-bottom: 8px;
    }
    .plan-info value {
      font-size: 18px;
      font-weight: 600;
      display: block;
    }
    .connected-time {
      margin-top: 20px;
      font-size: 13px;
      opacity: 0.85;
    }
    .warning {
      background: #ff6b6b;
      border-radius: 12px;
      padding: 15px;
      margin: 20px auto;
      max-width: 500px;
      font-size: 14px;
      font-weight: 500;
      animation: pulse 1s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.8; }
    }
    .logout-btn {
      background: rgba(255,255,255,0.2);
      color: white;
      border: 2px solid white;
      padding: 12px 30px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 20px;
      transition: all 0.3s;
    }
    .logout-btn:hover {
      background: white;
      color: #667eea;
    }
  </style>
</head>
<body>
  <div class="dashboard">
    <h1>⏱️ Time Remaining</h1>
    <div class="time-display" id="timer">--:--</div>
    
    <div class="plan-info">
      <div>
        <label>PLAN</label>
        <value><%= voucher.plan %></value>
      </div>
      <div>
        <label>PRICE</label>
        <value>₱<%= voucher.price %></value>
      </div>
    </div>

    <div class="connected-time" id="connectedTime"></div>

    <div id="warningBox"></div>

    <form method="POST" action="/logout" style="margin-top: 20px;">
      <button type="submit" class="logout-btn">Disconnect</button>
    </form>
  </div>

  <script>
    const expiresAt = <%= voucher.expires_at %>;
    const warningThreshold = 2 * 60 * 1000; // 2 minutes

    function updateTimer() {
      const now = Date.now();
      const msRemaining = expiresAt - now;

      if (msRemaining <= 0) {
        document.getElementById('timer').textContent = '00:00';
        document.getElementById('timer').style.color = '#ff6b6b';
        return;
      }

      const mins = Math.floor(msRemaining / 60000);
      const secs = Math.floor((msRemaining % 60000) / 1000);
      document.getElementById('timer').textContent = 
        String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');

      // Show warning if 2 minutes or less
      const warningBox = document.getElementById('warningBox');
      if (msRemaining <= warningThreshold && msRemaining > 0) {
        if (!warningBox.innerHTML) {
          warningBox.innerHTML = '⚠️ <strong>2 minutes left!</strong> Your connection will end soon.';
          warningBox.className = 'warning';
        }
      } else if (msRemaining > warningThreshold) {
        warningBox.innerHTML = '';
        warningBox.className = '';
      }

      // Change color to red when under 1 minute
      if (msRemaining < 60000) {
        document.getElementById('timer').style.color = '#ff6b6b';
      }
    }

    // Update every 500ms for smooth countdown
    setInterval(updateTimer, 500);
    updateTimer();

    // Show connected time
    const connectedTime = new Date(<%= voucher.started_at %>).toLocaleTimeString();
    document.getElementById('connectedTime').textContent = '📍 Connected: ' + connectedTime;
  </script>
</body>
</html>
