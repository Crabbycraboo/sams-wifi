<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background: var(--blue-900); [cite: 39]
      min-height: 100vh; [cite: 40]
      display: flex; [cite: 40]
      flex-direction: column; [cite: 40]
      align-items: center; [cite: 40]
      justify-content: center; [cite: 40]
      padding: 20px; [cite: 40]
    }
    .portal-card {
      width: 100%; [cite: 41]
      max-width: 440px; [cite: 41]
      background: rgba(255,255,255,0.04); [cite: 41]
      border: 1px solid rgba(255,255,255,0.08); [cite: 42]
      border-radius: var(--radius); [cite: 42]
      padding: 36px 28px; [cite: 42]
      backdrop-filter: blur(20px); [cite: 42]
      text-align: center; [cite: 42]
    }
    .status-badge {
      display: inline-flex; [cite: 43]
      align-items: center; [cite: 43]
      gap: 6px; [cite: 43]
      background: rgba(16,185,129,0.12); [cite: 43]
      border: 1px solid rgba(16,185,129,0.3); [cite: 44]
      color: var(--success); [cite: 44]
      padding: 6px 14px; [cite: 44]
      border-radius: 99px; [cite: 44]
      font-size: 0.8rem; [cite: 44]
      font-weight: 600; [cite: 44]
      margin-bottom: 28px; [cite: 44]
    }
    .status-dot {
      width: 7px; height: 7px; [cite: 45]
      background: var(--success); [cite: 45]
      border-radius: 50%; [cite: 45]
      animation: blink 1.5s ease-in-out infinite; [cite: 46]
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} } [cite: 46]
    /* Circular timer */
    .timer-wrap {
      position: relative; [cite: 46]
      width: 180px; [cite: 47]
      height: 180px; [cite: 47]
      margin: 0 auto 28px; [cite: 47]
    }
    .timer-svg { transform: rotate(-90deg); } [cite: 47, 48]
    .timer-bg { fill: none; stroke: rgba(255,255,255,0.06); stroke-width: 8; } [cite: 48, 49]
    .timer-ring {
      fill: none; [cite: 49]
      stroke: var(--accent); [cite: 49]
      stroke-width: 8; [cite: 49]
      stroke-linecap: round; [cite: 49]
      stroke-dasharray: 502; [cite: 50]
      stroke-dashoffset: 0; [cite: 50]
      transition: stroke-dashoffset 1s linear, stroke 0.5s; [cite: 50]
    }
    .timer-inner {
      position: absolute; [cite: 51]
      inset: 0; [cite: 51]
      display: flex; [cite: 51]
      flex-direction: column; [cite: 51]
      align-items: center; [cite: 52]
      justify-content: center; [cite: 52]
    }
    .timer-time {
      font-size: 2.4rem; [cite: 52]
      font-weight: 800; [cite: 52]
      font-family: var(--mono); [cite: 53]
      letter-spacing: 2px; [cite: 53]
      line-height: 1; [cite: 53]
    }
    .timer-label {
      font-size: 0.65rem; [cite: 53]
      letter-spacing: 2px; [cite: 54]
      text-transform: uppercase; [cite: 54]
      color: var(--gray-400); [cite: 54]
      margin-top: 4px; [cite: 54]
    }
    .info-grid {
      display: grid; [cite: 54]
      grid-template-columns: 1fr 1fr; [cite: 55]
      gap: 12px; [cite: 55]
      margin-bottom: 20px; [cite: 55]
    }
    .info-cell {
      background: rgba(255,255,255,0.03); [cite: 55]
      border: 1px solid rgba(255,255,255,0.07); [cite: 56]
      border-radius: var(--radius-sm); [cite: 56]
      padding: 14px 12px; [cite: 56]
    }
    .info-cell .lbl {
      font-size: 0.68rem; [cite: 56]
      font-weight: 600; [cite: 57]
      letter-spacing: 1px; [cite: 57]
      text-transform: uppercase; [cite: 57]
      color: var(--gray-400); [cite: 57]
      margin-bottom: 6px; [cite: 57]
    }
    .info-cell .val {
      font-size: 1rem; [cite: 58]
      font-weight: 700; [cite: 58]
      color: var(--white); [cite: 58]
      font-family: var(--mono); [cite: 58]
    }
    .info-cell.full { grid-column: 1 / -1; } [cite: 59, 60]
    .keep-open-note {
      font-size: 0.78rem; [cite: 60]
      color: var(--gray-400); [cite: 61]
      margin-bottom: 20px; [cite: 61]
      line-height: 1.5; [cite: 61]
    }
    .warning-bar {
      background: rgba(239,68,68,0.12); [cite: 61]
      border: 1px solid rgba(239,68,68,0.3); [cite: 62]
      color: #fca5a5; [cite: 62]
      padding: 10px 14px; [cite: 62]
      border-radius: var(--radius-sm); [cite: 62]
      font-size: 0.82rem; [cite: 62]
      font-weight: 600; [cite: 62]
      margin-bottom: 16px; [cite: 62]
      display: none; [cite: 62]
      animation: pulse 1s infinite; [cite: 62]
    }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.7} } [cite: 63]
    .btn-logout {
      width: 100%; [cite: 63]
      padding: 13px; [cite: 64]
      background: transparent; [cite: 64]
      color: var(--gray-400); [cite: 64]
      border: 1.5px solid rgba(255,255,255,0.1); [cite: 64]
      border-radius: var(--radius-sm); [cite: 64]
      font-size: 0.9rem; [cite: 64]
      font-weight: 600; [cite: 64]
      cursor: pointer; [cite: 64]
      transition: all 0.2s; [cite: 65]
    }
    .btn-logout:hover {
      border-color: var(--danger); [cite: 65]
      color: var(--danger); [cite: 66]
    }
    .footer-note {
      text-align: center; [cite: 66]
      margin-top: 20px; [cite: 67]
      font-size: 0.75rem; [cite: 67]
      color: var(--gray-400); [cite: 67]
    }
  </style>
</head>
<body>
  <div class="portal-card">
    <div class="status-badge">
      <span class="status-dot"></span>
      Konektado / Connected
    </div>

    <div class="timer-wrap">
      <svg class="timer-svg" width="180" height="180" viewBox="0 0 180 180">
        <circle class="timer-bg" cx="90" cy="90" r="80"/>
        <circle class="timer-ring" id="timerRing" cx="90" cy="90" r="80"/>
      </svg>
      <div class="timer-inner">
        <div class="timer-time" id="timerText">--:--</div> [cite: 68]
        <div class="timer-label">Natitira / Remaining</div>
      </div>
    </div>

    <div id="warningBar" class="warning-bar">⚠️ 2 minuto na lang! / 2 minutes left!</div> [cite: 69]

    <div class="info-grid">
      <div class="info-cell">
        <div class="lbl">Voucher Code</div>
        <div class="val"><%= voucher.code %></div>
      </div>
      <div class="info-cell">
        <div class="lbl">Plano / Plan</div>
        <div class="val"><%= voucher.duration_minutes %> Mins</div>
      </div>
      <div class="info-cell">
        <div class="lbl">Natapos sa / Expires</div>
        <div class="val" id="expiryTime">--:--</div>
      </div>
      <div class="info-cell">
        <div class="lbl">Katayuan / Status</div>
        <div class="val" style="color:var(--success);">● Aktibo</div>
      </div>
      <div class="info-cell full">
        <div class="lbl">Network Allocation Token</div>
        <div class="val" style="font-size: 0.85rem;"><%= voucher.token %></div>
      </div>
    </div>

    <div class="keep-open-note">
      📌 Huwag isara ang tab na ito habang konektado.<br> [cite: 71]
      <small>Keep this tab open while connected.</small> [cite: 71]
    </div>

    <form method="POST" action="logout">
      <button type="submit" class="btn-logout">📴 Mag-logout / Disconnect</button>
    </form>
  </div>

  <div class="footer-note">📍 Sam's WiFi – Taytay, Rizal</div>

  <script>
    const expiresAt  = <%= voucher.expires_at %>; [cite: 72]
    // Fall back to simple programmatic mathematical subtraction parameters
    const totalMs    = <%= msRemaining %>; 
    const CIRCUMFERENCE = 2 * Math.PI * 80; // 502.65 [cite: 73]

    const ring       = document.getElementById('timerRing'); [cite: 74]
    const timerText  = document.getElementById('timerText'); [cite: 74]
    const warningBar = document.getElementById('warningBar'); [cite: 74]
    const expiryTime = document.getElementById('expiryTime'); [cite: 74, 75]

    expiryTime.textContent = new Date(expiresAt).toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' }); [cite: 75]
    ring.style.strokeDasharray  = CIRCUMFERENCE; [cite: 76]
    ring.style.strokeDashoffset = 0; [cite: 76]

    function updateTimer() {
      const now = Date.now();
      const ms  = expiresAt - now; [cite: 77]

      if (ms <= 0) { [cite: 78]
        timerText.textContent = '00:00'; [cite: 78]
        timerText.style.color = 'var(--danger)'; [cite: 78]
        ring.style.strokeDashoffset = CIRCUMFERENCE; [cite: 78, 79]
        ring.style.stroke = 'var(--danger)'; [cite: 79]
        window.location.href = 'expired';
        return; [cite: 79]
      }

      const mins = Math.floor(ms / 60000); [cite: 79, 80]
      const secs = Math.floor((ms % 60000) / 1000); [cite: 80]
      timerText.textContent = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0'); [cite: 80]

      const progress = ms / totalMs; [cite: 81]
      ring.style.strokeDashoffset = CIRCUMFERENCE * (1 - progress); [cite: 81]

      if (ms < 60000) { [cite: 81, 82]
        timerText.style.color = 'var(--danger)'; [cite: 82]
        ring.style.stroke = 'var(--danger)'; [cite: 82]
      } else if (ms < 2 * 60000) { [cite: 83]
        timerText.style.color = '#fcd34d'; [cite: 83]
        ring.style.stroke = '#fcd34d'; [cite: 83]
        warningBar.style.display = 'block'; [cite: 83]
      }
    }

    // Polling targeting relative checkpoint parameters cleanly
    async function checkSession() {
      try {
        const res = await fetch(`api/gateway/check?mac=<%= voucher.mac_address || "00:00:00:00:00:00" %>`);
        const statusText = await res.text();
        
        if (statusText !== 'allow') {
          window.location.href = 'expired';
        }
      } catch(e) { /* suppress crash on network glitches */ }
    }

    setInterval(updateTimer, 500); [cite: 86]
    updateTimer(); [cite: 86]

    setInterval(checkSession, 15000);
    checkSession();
  </script>
</body>
</html>
