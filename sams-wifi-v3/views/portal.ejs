<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background: var(--blue-900);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .portal-card {
      width: 100%;
      max-width: 440px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: var(--radius);
      padding: 36px 28px;
      backdrop-filter: blur(20px);
      text-align: center;
    }
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(16,185,129,0.12);
      border: 1px solid rgba(16,185,129,0.3);
      color: var(--success);
      padding: 6px 14px;
      border-radius: 99px;
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 28px;
    }
    .status-dot {
      width: 7px; height: 7px;
      background: var(--success);
      border-radius: 50%;
      animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
    /* Circular timer */
    .timer-wrap {
      position: relative;
      width: 180px;
      height: 180px;
      margin: 0 auto 28px;
    }
    .timer-svg { transform: rotate(-90deg); }
    .timer-bg { fill: none; stroke: rgba(255,255,255,0.06); stroke-width: 8; }
    .timer-ring {
      fill: none;
      stroke: var(--accent);
      stroke-width: 8;
      stroke-linecap: round;
      stroke-dasharray: 502;
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1s linear, stroke 0.5s;
    }
    .timer-inner {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .timer-time {
      font-size: 2.4rem;
      font-weight: 800;
      font-family: var(--mono);
      letter-spacing: 2px;
      line-height: 1;
    }
    .timer-label {
      font-size: 0.65rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--gray-400);
      margin-top: 4px;
    }
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 20px;
    }
    .info-cell {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: var(--radius-sm);
      padding: 14px 12px;
    }
    .info-cell .lbl {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--gray-400);
      margin-bottom: 6px;
    }
    .info-cell .val {
      font-size: 1rem;
      font-weight: 700;
      color: var(--white);
      font-family: var(--mono);
    }
    .info-cell.full { grid-column: 1 / -1; }
    .keep-open-note {
      font-size: 0.78rem;
      color: var(--gray-400);
      margin-bottom: 20px;
      line-height: 1.5;
    }
    .warning-bar {
      background: rgba(239,68,68,0.12);
      border: 1px solid rgba(239,68,68,0.3);
      color: #fca5a5;
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 600;
      margin-bottom: 16px;
      display: none;
      animation: pulse 1s infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.7} }
    .btn-logout {
      width: 100%;
      padding: 13px;
      background: transparent;
      color: var(--gray-400);
      border: 1.5px solid rgba(255,255,255,0.1);
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-logout:hover {
      border-color: var(--danger);
      color: var(--danger);
    }
    .footer-note {
      text-align: center;
      margin-top: 20px;
      font-size: 0.75rem;
      color: var(--gray-400);
    }
  </style>
</head>
<body>
  <div class="portal-card">
    <div class="status-badge">
      <span class="status-dot"></span>
      Konektado / Connected
    </div>

    <div class="timer-wrap">
      <svg class="timer-svg" width="180" height="180" viewBox="0 0 180 180">
        <circle class="timer-bg" cx="90" cy="90" r="80"/>
        <circle class="timer-ring" id="timerRing" cx="90" cy="90" r="80"/>
      </svg>
      <div class="timer-inner">
        <div class="timer-time" id="timerText">--:--</div>
        <div class="timer-label">Natitira / Remaining</div>
      </div>
    </div>

    <div id="warningBar" class="warning-bar">⚠️ 2 minuto na lang! / 2 minutes left!</div>

    <div class="info-grid">
      <div class="info-cell">
        <div class="lbl">Voucher Code</div>
        <div class="val"><%= voucher.code %></div>
      </div>
      <div class="info-cell">
        <div class="lbl">Plano / Duration</div>
        <div class="val"><%= voucher.duration_minutes %> Mins</div>
      </div>
      <div class="info-cell">
        <div class="lbl">Natapos sa / Expires</div>
        <div class="val" id="expiryTime">--:--</div>
      </div>
      <div class="info-cell">
        <div class="lbl">Katayuan / Status</div>
        <div class="val" style="color:var(--success);">● Aktibo / Active</div>
      </div>
    </div>

    <div class="keep-open-note">
      📌 Huwag isara ang tab na ito habang konektado.<br>
      <small>Keep this tab open while connected.</small>
    </div>

    <form method="POST" action="/logout">
      <button type="submit" class="btn-logout">📴 Mag-logout / Disconnect</button>
    </form>
  </div>

  <div class="footer-note">📍 Sam's WiFi – Taytay, Rizal</div>

<script>
  let ms = <%= msRemaining %>;
  const timerText = document.getElementById('timer');
  
  function update() {
    if (ms <= 0) { window.location.href = '/expired'; return; }
    ms -= 1000;
    const mins = Math.floor(ms / 60000);
    const secs = Math.floor((ms % 60000) / 1000);
    timerText.textContent = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
  }
  setInterval(update, 1000);
</script>
</body>
</html>
