<!DOCTYPE html>
<html lang="en">
<head>
<div id="notificationPanel" style="position: fixed; top: 20px; right: 20px; width: 350px; max-height: 400px; background: white; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); z-index: 1000; overflow-y: auto; display: none;">
  <div style="padding: 15px; border-bottom: 1px solid #eee; font-weight: 600;">
    🔔 Notifications
  </div>
  <div id="notificationList"></div>
</div>

<script>
  async function loadNotifications() {
    const res = await fetch('/api/notifications');
    const notifs = await res.json();
    
    const list = document.getElementById('notificationList');
    if (notifs.length === 0) {
      list.innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">No new notifications</div>';
      return;
    }

    list.innerHTML = notifs.map(n => `
      <div style="padding: 12px 15px; border-bottom: 1px solid #f0f0f0; font-size: 13px;">
        <div style="font-weight: 600; margin-bottom: 5px;">
          ${n.type === 'sale' ? '💰' : n.type === 'expiring' ? '⏱️' : '🚨'} ${n.message}
        </div>
        <div style="color: #999; font-size: 12px;">
          ${new Date(n.created_at).toLocaleTimeString()}
        </div>
      </div>
    `).join('');

    // Show browser notification for first unread
    if (notifs.length > 0) {
      const first = notifs[0];
      new Notification('Sam WiFi', {
        body: first.message,
        icon: '/icon.png'
      });
    }
  }

  // Load every 10 seconds
  loadNotifications();
  setInterval(loadNotifications, 10000);

  // Click to toggle panel
  document.addEventListener('keydown', (e) => {
    if (e.key === 'n') {
      const panel = document.getElementById('notificationPanel');
      panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
    }
  });
</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <div class="brand-title"><span>Sam's</span> WiFi</div>
    <div class="brand-sub">Admin Panel</div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section-label">Main</div>
    <a href="/admin" class="nav-link active"><span class="nav-icon">📊</span> Dashboard</a>
    <a href="/admin/vouchers" class="nav-link"><span class="nav-icon">🎫</span> Vouchers</a>

    <div class="nav-section-label" style="margin-top:12px;">Tools</div>
    <a href="#load-rec" class="nav-link"><span class="nav-icon">📶</span> Load Recommendation</a>
    <a href="#sales" class="nav-link"><span class="nav-icon">💰</span> Sales Tracker</a>
    <a href="#active-users" class="nav-link"><span class="nav-icon">👥</span> Active Users</a>

    <div class="nav-section-label" style="margin-top:12px;">Settings</div>
    <a href="#change-password" class="nav-link" onclick="showPasswordModal()"><span class="nav-icon">🔑</span> Change Password</a>
    <a href="/" class="nav-link" target="_blank"><span class="nav-icon">🌐</span> Customer Portal</a>
  </nav>
  <div class="sidebar-footer">
    Logged in as <span class="admin-name"><%= adminUser %></span><br>
    <form action="/admin/logout" method="POST" style="margin-top:8px;">
      <button type="submit" style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:0.8rem;padding:0;font-family:var(--font);">
        ⏏ Logout
      </button>
    </form>
  </div>
</aside>

<!-- Main -->
<main class="admin-main">
  <div class="admin-topbar">
    <div style="display:flex;align-items:center;gap:12px;">
      <button class="btn btn-outline btn-sm no-print" id="menuBtn" onclick="toggleSidebar()" style="display:none;">☰</button>
      <h1>Dashboard</h1>
    </div>
    <div style="display:flex;align-items:center;gap:8px;">
      <span style="font-size:0.8rem;color:var(--gray-400);" id="lastRefresh"></span>
      <button class="btn btn-outline btn-sm" onclick="refreshData()">🔄 Refresh</button>
    </div>
  </div>

  <div class="admin-content">

    <!-- ── Sleep Mode Toggle ─────────────────────────────────────────── -->
    <div class="no-print" style="margin-bottom:20px;padding:16px 20px;background:<%= sleepMode ? 'rgba(251,191,36,0.1)' : 'rgba(255,255,255,0.04)' %>;border:1px solid <%= sleepMode ? 'rgba(251,191,36,0.4)' : 'rgba(255,255,255,0.08)' %>;border-radius:var(--radius);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <div style="font-weight:700;font-size:0.95rem;color:<%= sleepMode ? '#fcd34d' : 'var(--white)' %>;">
          <%= sleepMode ? '😴 Sleep Mode is ON' : '☀️ Sleep Mode is OFF' %>
        </div>
        <div style="font-size:0.8rem;color:var(--gray-400);margin-top:2px;">
          <%= sleepMode ? '₱5 vouchers blocked. GCash QR shown to customers.' : 'All plans available. Customers paying cash.' %>
        </div>
      </div>
      <button
        id="sleepToggleBtn"
        onclick="toggleSleepMode()"
        class="btn <%= sleepMode ? 'btn-warning' : 'btn-outline' %>"
        style="min-width:140px;">
        <%= sleepMode ? '☀️ Wake Up' : '😴 Go to Sleep' %>
      </button>
    </div>

    <!-- ── Top Stats ─────────────────────────────────────────────────── -->
    <div class="grid-4" style="margin-bottom:24px;">
      <div class="stat-card" style="--stat-color:var(--success);">
        <div class="stat-icon">👥</div>
        <div class="stat-label">Active Users</div>
        <div class="stat-value" id="statActive"><%= activeUsers.length %></div>
        <div class="stat-sub">Currently connected</div>
      </div>
      <div class="stat-card" style="--stat-color:var(--blue-300);">
        <div class="stat-icon">💰</div>
        <div class="stat-label">Today's Sales</div>
        <div class="stat-value">₱<%= sales.todaySales.total %></div>
        <div class="stat-sub"><%= sales.todaySales.count %> sessions today</div>
      </div>
      <div class="stat-card" style="--stat-color:var(--accent);">
        <div class="stat-icon">🎫</div>
        <div class="stat-label">Unused Vouchers</div>
        <div class="stat-value"><%= unusedCounts['30min'] + unusedCounts['1hr'] + unusedCounts['3hr'] + unusedCounts['unli'] %></div>
        <div class="stat-sub">Ready to sell</div>
      </div>
      <div class="stat-card" style="--stat-color:var(--warning);">
        <div class="stat-icon">📈</div>
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value">₱<%= sales.totalSales.total %></div>
        <div class="stat-sub"><%= sales.totalSales.count %> total sessions</div>
      </div>
    </div>

    <!-- ── Load Recommendation ───────────────────────────────────────── -->
    <div id="load-rec" class="load-rec-card no-print" style="margin-bottom:24px;">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:12px;">
        <div>
          <h3>📶 Load Recommendation / Rekomendasyon ng Load</h3>
          <p style="font-size:0.85rem;color:var(--gray-400);margin-bottom:12px;">
            Batay sa <%= activeUsers.length %> aktibong users ngayon / Based on <%= activeUsers.length %> active users now
          </p>
          <div style="display:flex;align-items:baseline;gap:8px;">
            <div class="load-amount">₱<%= loadRec.recommendation.load %></div>
            <div style="color:var(--gray-400);font-size:0.9rem;">para sa / for <strong style="color:var(--white);"><%= loadRec.recommendation.period %></strong></div>
          </div>
          <p style="font-size:0.8rem;color:var(--blue-200);margin-top:8px;">
            <% if(loadRec.recommendation.class === 'low') { %>
              💡 Mababa ang traffic — ₱50 load ay sapat na. (Low traffic — ₱50 is enough.)
            <% } else if(loadRec.recommendation.class === 'medium') { %>
              ⚡ Katamtamang traffic — mag-load ng ₱85. (Medium traffic — load ₱85.)
            <% } else { %>
              🔥 Mataas ang traffic — mag-load ng ₱200! (High traffic — load ₱200!)
            <% } %>
          </p>
        </div>
        <div style="text-align:right;">
          <div style="font-size:0.75rem;color:var(--gray-400);margin-bottom:4px;">Traffic Level</div>
          <div class="load-bars" style="width:120px;">
            <div class="load-bar <%= loadRec.recommendation.class !== '' ? 'filled' : '' %>"></div>
            <div class="load-bar <%= loadRec.recommendation.class === 'medium' || loadRec.recommendation.class === 'high' ? 'filled' : '' %>" style="--accent:var(--warning)"></div>
            <div class="load-bar <%= loadRec.recommendation.class === 'high' ? 'filled' : '' %>" style="<%= loadRec.recommendation.class === 'high' ? '--accent:var(--danger)' : '' %>"></div>
          </div>
          <div style="font-size:0.7rem;color:var(--gray-400);margin-top:4px;">Low / Med / High</div>
        </div>
      </div>
    </div>

    <!-- ── Two column: Active Users + Sales ──────────────────────────── -->
    <div class="grid-2" style="margin-bottom:24px;">

      <!-- Active Users -->
      <div id="active-users" class="card" style="background:rgba(255,255,255,0.03);">
        <div class="flex-between" style="margin-bottom:16px;">
          <h3>👥 Active Users</h3>
          <span class="badge badge-active"><%= activeUsers.length %> online</span>
        </div>
        <% if (activeUsers.length === 0) { %>
          <p style="color:var(--gray-400);font-size:0.9rem;text-align:center;padding:20px 0;">
            Walang aktibong user ngayon.<br><small>No active users right now.</small>
          </p>
        <% } else { %>
          <div style="overflow-x:auto;">
            <table class="users-table">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Plan</th>
                  <th>Remaining</th>
                </tr>
              </thead>
              <tbody id="activeUsersBody">
                <% activeUsers.forEach(u => {
                  const msLeft = u.expires_at - Date.now();
                  const minLeft = Math.floor(msLeft/60000);
                  const timeClass = minLeft < 5 ? 'time-crit' : minLeft < 15 ? 'time-warn' : 'time-ok';
                  const hrs = Math.floor(minLeft/60);
                  const mins = minLeft % 60;
                  const timeStr = hrs > 0 ? `${hrs}h ${mins}m` : `${mins}m`;
                %>
                <tr>
                  <td class="code-cell"><%= u.code %></td>
                  <td>
                    <% if(u.plan==='30min'){%>₱5<% } else if(u.plan==='1hr'){%>₱10<% } else {%>₱20<% } %>
                  </td>
                  <td class="time-remaining <%= timeClass %>"><%= timeStr %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- Sales This Week -->
      <div id="sales" class="card" style="background:rgba(255,255,255,0.03);">
        <div class="flex-between" style="margin-bottom:4px;">
          <h3>💰 Sales This Week</h3>
          <span style="font-size:0.8rem;color:var(--gray-400);">7 days</span>
        </div>
        <p style="font-size:0.8rem;color:var(--gray-400);margin-bottom:12px;">₱<%= sales.weekSales.total %> — <%= sales.weekSales.count %> sessions</p>

        <!-- Bar chart -->
        <% const maxRev = Math.max(...sales.dailyBreakdown.map(d=>d.revenue), 1); %>
        <div class="sales-bars">
          <% sales.dailyBreakdown.forEach(day => {
            const pct = Math.round((day.revenue / maxRev) * 100);
            const label = new Date(day.day).toLocaleDateString('en-PH',{weekday:'short'});
          %>
          <div class="sales-bar-wrap">
            <div class="sales-bar-val">₱<%= day.revenue %></div>
            <div class="sales-bar" style="height:<%= Math.max(pct,4) %>%;"></div>
            <div class="sales-bar-label"><%= label %></div>
          </div>
          <% }) %>
          <% if(sales.dailyBreakdown.length === 0) { %>
            <p style="color:var(--gray-400);font-size:0.85rem;text-align:center;width:100%;padding:20px 0;">
              Walang data pa.<br><small>No sales data yet.</small>
            </p>
          <% } %>
        </div>

        <!-- By plan breakdown -->
        <div style="margin-top:16px;border-top:1px solid rgba(255,255,255,0.06);padding-top:14px;">
          <p style="font-size:0.75rem;color:var(--gray-400);margin-bottom:10px;text-transform:uppercase;letter-spacing:0.07em;">By Plan</p>
          <% sales.byPlan.forEach(p => { %>
          <div class="flex-between" style="margin-bottom:8px;">
            <span style="font-size:0.85rem;">
              <% if(p.plan==='30min'){%>₱5 – 30 Min<% } else if(p.plan==='1hr'){%>₱10 – 1 Hr<% } else {%>₱20 – 3 Hrs<% } %>
            </span>
            <span style="font-size:0.85rem;color:var(--accent);font-family:var(--mono);">
              ₱<%= p.revenue %> (<%= p.count %>x)
            </span>
          </div>
          <% }) %>
          <% if(sales.byPlan.length === 0) { %>
            <p style="font-size:0.8rem;color:var(--gray-400);">No data yet.</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ── Quick Generate ─────────────────────────────────────────────── -->
    <div class="gen-card no-print">
      <h3 style="margin-bottom:4px;">🎫 Quick Voucher Generator</h3>
      <p style="font-size:0.8rem;color:var(--gray-400);margin-bottom:16px;">
        Para sa mas maraming opsyon, pumunta sa <a href="/admin/vouchers" style="color:var(--blue-300);">Vouchers page</a>.
      </p>

      <div class="plan-selector">
        <div class="plan-option">
          <input type="radio" name="quickPlan" id="qp30" value="30min" checked>
          <label for="qp30"><span class="plan-price">₱5</span><span class="plan-dur">30 Minutes</span></label>
        </div>
        <div class="plan-option">
          <input type="radio" name="quickPlan" id="qp1h" value="1hr">
          <label for="qp1h"><span class="plan-price">₱10</span><span class="plan-dur">1 Hour</span></label>
        </div>
        <div class="plan-option">
          <input type="radio" name="quickPlan" id="qp3h" value="3hr">
          <label for="qp3h"><span class="plan-price">₱20</span><span class="plan-dur">3 Hours</span></label>
        </div>
      </div>

      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:8px;">
          <label style="font-size:0.85rem;color:var(--gray-400);">Quantity:</label>
          <select id="quickCount" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:var(--white);border-radius:var(--radius-sm);padding:8px 12px;font-family:var(--font);font-size:0.9rem;">
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20" selected>20 (1 sheet)</option>
            <option value="40">40 (2 sheets)</option>
            <option value="60">60 (3 sheets)</option>
          </select>
        </div>
        <button class="btn btn-success" onclick="quickGenerate()">⚡ Generate</button>
        <button class="btn btn-outline btn-sm" onclick="printCodes()" id="printBtn" style="display:none;">🖨️ Print</button>
        <button class="btn btn-outline btn-sm" onclick="copyCodes()" id="copyBtn" style="display:none;">📋 Copy All</button>
      </div>

      <div class="codes-output" id="codesOutput">
        <div class="codes-grid" id="codesGrid"></div>
      </div>
      <div id="genMsg" style="font-size:0.85rem;margin-top:8px;"></div>
    </div>

    <!-- Unused voucher inventory -->
    <div class="card" style="background:rgba(255,255,255,0.02);margin-top:0;">
      <h3 style="margin-bottom:14px;">📦 Voucher Inventory</h3>
      <div class="grid-3">
        <div style="text-align:center;padding:12px;">
          <div style="font-size:2rem;font-weight:800;color:var(--accent);font-family:var(--mono);"><%= unusedCounts['30min'] %></div>
          <div style="font-size:0.8rem;color:var(--gray-400);margin-top:4px;">₱5 / 30min unused</div>
        </div>
        <div style="text-align:center;padding:12px;border-left:1px solid rgba(255,255,255,0.06);border-right:1px solid rgba(255,255,255,0.06);">
          <div style="font-size:2rem;font-weight:800;color:var(--accent);font-family:var(--mono);"><%= unusedCounts['1hr'] %></div>
          <div style="font-size:0.8rem;color:var(--gray-400);margin-top:4px;">₱10 / 1hr unused</div>
        </div>
        <div style="text-align:center;padding:12px;">
          <div style="font-size:2rem;font-weight:800;color:var(--accent);font-family:var(--mono);"><%= unusedCounts['3hr'] %></div>
          <div style="font-size:0.8rem;color:var(--gray-400);margin-top:4px;">₱20 / 3hrs unused</div>
        </div>
      </div>
      <div style="border-top:1px solid rgba(255,255,255,0.06);margin-top:8px;padding-top:12px;text-align:center;">
        <div style="font-size:2rem;font-weight:800;color:#fcd34d;font-family:var(--mono);"><%= unusedCounts['unli'] %></div>
        <div style="font-size:0.8rem;color:var(--gray-400);margin-top:4px;">🔥 ₱60 / Unli Day unused</div>
      </div>
    </div>

  </div><!-- /admin-content -->
</main>

<!-- Change Password Modal -->
<div id="pwModal" style="display:none;position:fixed;inset:0;background:rgba(10,22,40,0.85);backdrop-filter:blur(6px);z-index:200;align-items:center;justify-content:center;padding:20px;">
  <div class="card" style="max-width:360px;width:100%;">
    <h3 style="margin-bottom:16px;">🔑 Change Password</h3>
    <div id="pwMsg" style="margin-bottom:12px;"></div>
    <div class="form-group mb-2">
      <label class="form-label">Current Password</label>
      <input type="password" id="pwCurrent" class="form-input" placeholder="Current password">
    </div>
    <div class="form-group mb-2">
      <label class="form-label">New Password</label>
      <input type="password" id="pwNew" class="form-input" placeholder="New password (min 6 chars)">
    </div>
    <div class="form-group" style="margin-bottom:16px;">
      <label class="form-label">Confirm New Password</label>
      <input type="password" id="pwConfirm" class="form-input" placeholder="Repeat new password">
    </div>
    <div style="display:flex;gap:10px;">
      <button class="btn btn-primary" onclick="submitPassword()">Save</button>
      <button class="btn btn-outline" onclick="hidePasswordModal()">Cancel</button>
    </div>
  </div>
</div>

<script>
  // Last refresh time
  document.getElementById('lastRefresh').textContent = 'Updated: ' + new Date().toLocaleTimeString('en-PH');

  function refreshData() { window.location.reload(); }

  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }

  // Check mobile
  if (window.innerWidth <= 900) {
    document.getElementById('menuBtn').style.display = 'block';
  }

  // ── Quick Voucher Generator ─────────────────────────────────────────
  let generatedCodes = [];

  async function quickGenerate() {
    const plan  = document.querySelector('input[name="quickPlan"]:checked').value;
    const count = document.getElementById('quickCount').value;

    const genMsg = document.getElementById('genMsg');
    genMsg.textContent = '⏳ Generating...';
    genMsg.style.color = 'var(--gray-400)';

    try {
      const res  = await fetch('/admin/vouchers/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `plan=${plan}&count=${count}`
      });
      const data = await res.json();

      if (!data.success) throw new Error(data.error);

      generatedCodes = data.codes;
      const grid = document.getElementById('codesGrid');
      grid.innerHTML = data.codes.map(c => `<div class="code-chip">${c}</div>`).join('');

      document.getElementById('codesOutput').style.display = 'block';
      document.getElementById('printBtn').style.display = 'inline-flex';
      document.getElementById('copyBtn').style.display = 'inline-flex';

      genMsg.textContent = `✅ Generated ${data.count} vouchers (Batch: ${data.batchId})`;
      genMsg.style.color = 'var(--success)';
    } catch(e) {
      genMsg.textContent = '❌ Error: ' + e.message;
      genMsg.style.color = 'var(--danger)';
    }
  }

  function copyCodes() {
    navigator.clipboard.writeText(generatedCodes.join('\n'));
    const btn = document.getElementById('copyBtn');
    btn.textContent = '✅ Copied!';
    setTimeout(() => btn.textContent = '📋 Copy All', 2000);
  }

  function printCodes() {
    window.print();
  }

  // ── Password modal ──────────────────────────────────────────────────
  function showPasswordModal() {
    document.getElementById('pwModal').style.display = 'flex';
  }
  function hidePasswordModal() {
    document.getElementById('pwModal').style.display = 'none';
    document.getElementById('pwMsg').innerHTML = '';
    ['pwCurrent','pwNew','pwConfirm'].forEach(id => document.getElementById(id).value = '');
  }

  async function submitPassword() {
    const current  = document.getElementById('pwCurrent').value;
    const newpass  = document.getElementById('pwNew').value;
    const confirm  = document.getElementById('pwConfirm').value;
    const msgEl    = document.getElementById('pwMsg');

    const res  = await fetch('/admin/change-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `current=${encodeURIComponent(current)}&newpass=${encodeURIComponent(newpass)}&confirm=${encodeURIComponent(confirm)}`
    });
    const data = await res.json();

    if (data.success) {
      msgEl.innerHTML = '<div class="alert alert-success">✅ Password changed successfully!</div>';
      setTimeout(hidePasswordModal, 2000);
    } else {
      msgEl.innerHTML = `<div class="alert alert-error">⚠️ ${data.error}</div>`;
    }
  }

  // Auto-refresh active users every 60s
  setInterval(async () => {
    try {
      const res  = await fetch('/api/admin/active-users');
      const data = await res.json();
      document.getElementById('statActive').textContent = data.length;
      document.getElementById('lastRefresh').textContent = 'Updated: ' + new Date().toLocaleTimeString('en-PH');
    } catch(e) {}
  }, 60000);

async function toggleSleepMode() {
  const btn = document.getElementById('sleepToggleBtn');
  const currentlyAsleep = btn.textContent.includes('Wake Up');
  btn.disabled = true;
  btn.textContent = '⏳ Updating...';
  try {
    const res = await fetch('/admin/sleep-mode', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `enabled=${!currentlyAsleep}`
    });
    const data = await res.json();
    if (data.success) window.location.reload();
  } catch(e) {
    btn.disabled = false;
    btn.textContent = currentlyAsleep ? '☀️ Wake Up' : '😴 Go to Sleep';
    alert('Failed to update sleep mode. Try again.');
  }
}
</script>
</body>
</html>
