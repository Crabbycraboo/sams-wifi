<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <div class="brand-title"><span>Sam's</span> WiFi</div>
    <div class="brand-sub">Admin Panel</div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section-label">Main</div>
    <a href="/admin" class="nav-link active"><span class="nav-icon">📊</span> Dashboard</a>
    <a href="/admin/vouchers" class="nav-link"><span class="nav-icon">🎫</span> Vouchers</a>
    <div class="nav-section-label" style="margin-top:12px;">Settings</div>
    <a href="#" class="nav-link" onclick="showPasswordModal(); return false;"><span class="nav-icon">🔑</span> Change Password</a>
    <a href="/" class="nav-link" target="_blank"><span class="nav-icon">🌐</span> Customer Portal</a>
  </nav>
  <div class="sidebar-footer">
    Logged in as <span class="admin-name"><%= adminUser %></span><br>
    <form action="/admin/logout" method="POST" style="margin-top:8px;">
      <button type="submit" style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:0.8rem;padding:0;font-family:var(--font);">
        ⏏ Logout
      </button>
    </form>
  </div>
</aside>

<main class="admin-main">
  <div class="admin-topbar">
    <h1>Dashboard</h1>
    <button class="btn btn-outline btn-sm" onclick="refreshData()">🔄 Refresh</button>
  </div>

  <div class="admin-content">

    <!-- Sleep Mode -->
    <div style="margin-bottom:20px;padding:16px 20px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:var(--radius);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <div style="font-weight:700;font-size:0.95rem;color:var(--white);">
          <%= sleepMode ? '😴 Sleep Mode is ON' : '☀️ Sleep Mode is OFF' %>
        </div>
      </div>
      <button id="sleepToggleBtn" onclick="toggleSleepMode()" class="btn btn-outline" style="min-width:140px;">
        <%= sleepMode ? '☀️ Wake Up' : '😴 Go to Sleep' %>
      </button>
    </div>

    <!-- Stats -->
    <div class="grid-4" style="margin-bottom:24px;">
      <div class="stat-card">
        <div class="stat-icon">👥</div>
        <div class="stat-label">Active Users</div>
        <div class="stat-value"><%= activeUsers.length %></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">💰</div>
        <div class="stat-label">Today's Sales</div>
        <div class="stat-value">₱<%= sales.todaySales.total %></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🎫</div>
        <div class="stat-label">Unused Vouchers</div>
        <div class="stat-value"><%= (unusedCounts['5min'] || 0) + (unusedCounts['15min'] || 0) + (unusedCounts['30min'] || 0) + (unusedCounts['60min'] || 0) + (unusedCounts['3hrs'] || 0) %></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">📈</div>
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value">₱<%= sales.totalSales.total %></div>
      </div>
    </div>

    <!-- Active Users -->
    <div class="card" style="background:rgba(255,255,255,0.03);margin-bottom:24px;">
      <h3>👥 Active Users</h3>
      <% if (activeUsers.length === 0) { %>
        <p style="color:var(--gray-400);text-align:center;padding:20px 0;">No active users.</p>
      <% } else { %>
        <div style="overflow-x:auto;">
          <table class="users-table">
            <thead>
              <tr><th>Code</th><th>Plan</th><th>Remaining</th></tr>
            </thead>
            <tbody>
              <% activeUsers.forEach(u => {
                const mins = Math.floor((u.expires_at - Date.now()) / 60000);
                const hrs = Math.floor(mins / 60);
              %>
              <tr>
                <td><%= u.code %></td>
                <td><%= u.plan %></td>
                <td><%= hrs > 0 ? hrs + 'h ' + (mins % 60) + 'm' : mins + 'm' %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Sales -->
    <div class="card" style="background:rgba(255,255,255,0.03);">
      <h3>💰 Sales This Week</h3>
      <p style="color:var(--gray-400);">₱<%= sales.weekSales.total %> — <%= sales.weekSales.count %> sessions</p>
      <% if (sales.byPlan.length > 0) { %>
        <% sales.byPlan.forEach(p => { %>
          <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:0.85rem;">
            <span><%= p.plan %></span>
            <span style="color:var(--accent);">₱<%= p.revenue %> (<%= p.count %>x)</span>
          </div>
        <% }) %>
      <% } %>
    </div>

  </div>
</main>

<!-- Password Modal -->
<div id="pwModal" style="display:none;position:fixed;inset:0;background:rgba(10,22,40,0.85);z-index:200;align-items:center;justify-content:center;padding:20px;">
  <div class="card" style="max-width:360px;width:100%;">
    <h3>🔑 Change Password</h3>
    <div id="pwMsg" style="margin-bottom:12px;"></div>
    <div style="margin-bottom:12px;">
      <input type="password" id="pwCurrent" class="form-input" placeholder="Current password">
    </div>
    <div style="margin-bottom:12px;">
      <input type="password" id="pwNew" class="form-input" placeholder="New password">
    </div>
    <div style="margin-bottom:16px;">
      <input type="password" id="pwConfirm" class="form-input" placeholder="Confirm password">
    </div>
    <div style="display:flex;gap:10px;">
      <button class="btn btn-primary" onclick="submitPassword()">Save</button>
      <button class="btn btn-outline" onclick="hidePasswordModal()">Cancel</button>
    </div>
  </div>
</div>

<script>
  function refreshData() { location.reload(); }
  
  function showPasswordModal() { document.getElementById('pwModal').style.display = 'flex'; }
  function hidePasswordModal() { document.getElementById('pwModal').style.display = 'none'; }

  async function submitPassword() {
    const current = document.getElementById('pwCurrent').value;
    const newpass = document.getElementById('pwNew').value;
    const confirm = document.getElementById('pwConfirm').value;
    const msgEl = document.getElementById('pwMsg');

    try {
      const res = await fetch('/admin/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `current=${encodeURIComponent(current)}&newpass=${encodeURIComponent(newpass)}&confirm=${encodeURIComponent(confirm)}`
      });
      const data = await res.json();
      if (data.success) {
        msgEl.innerHTML = '<div style="color:#4ade80;">✅ Changed!</div>';
        setTimeout(hidePasswordModal, 1500);
      } else {
        msgEl.innerHTML = `<div style="color:#ef4444;">❌ ${data.error}</div>`;
      }
    } catch(e) {
      msgEl.innerHTML = '<div style="color:#ef4444;">❌ Error</div>';
    }
  }

  async function toggleSleepMode() {
    const btn = document.getElementById('sleepToggleBtn');
    btn.disabled = true;
    try {
      await fetch('/admin/sleep-mode', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `enabled=${<%= sleepMode %> ? 'false' : 'true'}`
      });
      location.reload();
    } catch(e) {
      btn.disabled = false;
    }
  }
</script>
</body>
</html>
