<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { display:flex; align-items:center; justify-content:center; min-height:100vh; padding:20px; text-align:center; }
    .error-wrapper { position:relative; z-index:1; max-width:400px; }
  </style>
</head>
<body>
  <div class="bg-network"></div>
  <div class="error-wrapper">
    <p style="font-size:4rem; margin-bottom:16px;">😵</p>
    <h1 style="margin-bottom:8px;"><%= title %></h1>
    <p style="color:var(--gray-400); margin-bottom:24px;"><%= message %></p>
    <a href="/" class="btn btn-primary">← Go Back Home</a>
  </div>
</body>
</html>
