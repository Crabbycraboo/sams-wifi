<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background: var(--blue-900);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .login-card {
      width: 100%;
      max-width: 480px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: var(--radius);
      padding: 40px 32px;
      backdrop-filter: blur(20px);
    }
    .brand {
      text-align: center;
      margin-bottom: 32px;
    }
    .brand-icon { font-size: 2.5rem; margin-bottom: 8px; }
    .brand h1 { font-size: 2rem; margin: 0; }
    .brand h1 span { color: var(--accent); }
    .brand-sub { font-size: 0.85rem; color: var(--gray-400); margin-top: 4px; }
    .plans-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--gray-400);
      margin-bottom: 12px;
    }
    .plans-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 24px;
    }
    .plan-card {
      background: rgba(255,255,255,0.04);
      border: 1.5px solid rgba(255,255,255,0.08);
      border-radius: var(--radius-sm);
      padding: 12px 8px;
      text-align: center;
    }
    .plan-price {
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--accent);
      font-family: var(--mono);
    }
    .plan-dur {
      font-size: 0.7rem;
      color: var(--gray-400);
      margin-top: 2px;
    }
    .form-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--gray-400);
      margin-bottom: 8px;
    }
    .form-input {
      width: 100%;
      padding: 14px 16px;
      background: rgba(255,255,255,0.06);
      border: 1.5px solid rgba(255,255,255,0.12);
      border-radius: var(--radius-sm);
      font-size: 1.1rem;
      font-family: var(--mono);
      color: var(--white);
      letter-spacing: 2px;
      text-transform: uppercase;
      box-sizing: border-box;
      transition: border-color 0.2s;
    }
    .form-input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(0,212,255,0.1);
    }
    .form-input::placeholder { color: var(--gray-400); letter-spacing: 1px; }
    .form-hint {
      font-size: 0.75rem;
      color: var(--gray-400);
      margin-top: 6px;
    }
    .btn-connect {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, var(--accent), #0090b3);
      color: var(--blue-900);
      border: none;
      border-radius: var(--radius-sm);
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 20px;
      transition: all 0.2s;
      letter-spacing: 0.5px;
    }
    .btn-connect:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,212,255,0.3);
    }
    .btn-trial {
      width: 100%;
      padding: 13px;
      background: transparent;
      color: var(--accent);
      border: 1.5px solid var(--accent);
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      margin-top: 14px;
      transition: all 0.2s;
    }
    .btn-trial:hover {
      background: rgba(0,212,255,0.08);
      box-shadow: 0 0 15px rgba(0,212,255,0.2);
    }
    .error-alert {
      background: rgba(239,68,68,0.12);
      border: 1px solid rgba(239,68,68,0.3);
      color: #fca5a5;
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      margin-bottom: 20px;
      font-size: 0.85rem;
      line-height: 1.5;
    }
    .gcash-box {
      margin-top: 24px;
      background: rgba(0,212,255,0.05);
      border: 1px solid rgba(0,212,255,0.15);
      border-radius: var(--radius-sm);
      padding: 18px;
      text-align: center;
    }
    .gcash-label {
      font-size: 0.75rem;
      color: var(--gray-400);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }
    .gcash-num {
      font-size: 1.4rem;
      font-weight: 800;
      font-family: var(--mono);
      color: var(--accent);
      letter-spacing: 2px;
    }
    .gcash-name {
      font-size: 0.8rem;
      color: var(--gray-400);
      margin-top: 4px;
    }
    .gcash-note {
      font-size: 0.75rem;
      color: var(--gray-400);
      margin-top: 10px;
      line-height: 1.5;
    }
    .sleep-banner {
      background: rgba(251,191,36,0.1);
      border: 1px solid rgba(251,191,36,0.25);
      color: #fcd34d;
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      text-align: center;
      margin-bottom: 20px;
    }
    .footer-note {
      text-align: center;
      margin-top: 20px;
      font-size: 0.75rem;
      color: var(--gray-400);
    }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="brand">
      <div class="brand-icon">📶</div>
      <h1>Sam's <span>WiFi</span></h1>
      <div class="brand-sub">Taytay, Rizal</div>
    </div>

    <% if (typeof sleepMode !== 'undefined' && sleepMode) { %>
      <div class="sleep-banner">
        😴 Sleep Mode – Minimum plan is ₱5.
        Pay via GCash and message for your code.
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-alert">⚠️ <%= error %></div>
    <% } %>

    <div class="plans-label">Available Plans</div>
    <div class="plans-grid">
      <% if (typeof plans !== 'undefined' && plans.length > 0) { %>
        <% plans.forEach(plan => { %>
          <div class="plan-card">
            <div class="plan-price"><%= plan.name.split('–')[0].trim() %></div>
            <div class="plan-dur"><%= plan.name.split('–')[1] ? plan.name.split('–')[1].trim() : plan.duration_minutes + ' Mins' %></div>
          </div>
        <% }) %>
      <% } else { %>
        <div style="grid-column:1/-1; color: var(--gray-400); font-size:0.85rem; text-align:center;">
          Loading plans...
        </div>
      <% } %>
    </div>

    <form method="POST" action="/redeem">
      <input type="hidden" name="mac" value="<%= (typeof mac !== 'undefined' && mac) ? mac : '' %>">

      <div style="margin-bottom: 20px;">
        <label class="form-label">Voucher Code</label>
        <input
          type="text"
          name="code"
          class="form-input"
          placeholder="SAM-XXXXXXXX"
          value=""
          maxlength="12"
          required
          autocomplete="off"
          autocorrect="off"
          autocapitalize="characters"
        >
        <div class="form-hint">📋 Enter the code from your voucher slip</div>
      </div>
      <button type="submit" class="btn-connect">🔗 Kumonekta / Connect</button>
    </form>

    <% if (typeof sleepMode === 'undefined' || !sleepMode) { %>
      <button id="trialBtn" class="btn-trial">🎁 Subukan ang Free 5-Mins Trial</button>
    <% } %>

    <div class="gcash-box">
      <div class="gcash-label">💳 Walang code? / No code?</div>
      <div class="gcash-num"><%= (typeof gcash !== 'undefined' && gcash) ? gcash.number : '09985801867' %></div>
      <div class="gcash-name"><%= (typeof gcash !== 'undefined' && gcash) ? gcash.name : 'Sam' %></div>
      <div class="gcash-note">
        Mag-GCash ng bayad at i-message ang ref number para sa inyong code.<br>
        <small>Send payment via GCash + message your ref # for your code.</small>
      </div>
    </div>
  </div>

  <div class="footer-note">📍 Sam's WiFi – Taytay, Rizal</div>

  <script>
    document.getElementById('trialBtn')?.addEventListener('click', async (e) => {
      e.preventDefault();
      const trialBtn = e.target;
      trialBtn.innerText = "⏳ Pag-activate...";
      trialBtn.disabled = true;

      try {
        const res = await fetch('/api/trial/activate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mac: '' })
        });
        const data = await res.json();
        if (data.success) {
          window.location.href = data.redirect;
        } else {
          alert(data.message || 'Error occurred.');
          trialBtn.innerText = "🎁 Subukan ang Free 5-Mins Trial";
          trialBtn.disabled = false;
        }
      } catch (err) {
        alert('Hindi makakonekta sa server.');
        trialBtn.disabled = false;
      }
    });
  </script>
</body>
</html>
