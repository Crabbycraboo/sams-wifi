<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

<!-- Sidebar -->
<aside class="sidebar">
  <div class="sidebar-brand">
    <div class="brand-title"><span>Sam's</span> WiFi</div>
    <div class="brand-sub">Admin Panel</div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section-label">Main</div>
    <a href="/admin/dashboard" class="nav-link"><span class="nav-icon">📊</span> Dashboard</a>
    <a href="/admin/vouchers" class="nav-link"><span class="nav-icon">🎫</span> Vouchers</a>
    <a href="/admin/orders" class="nav-link active"><span class="nav-icon">🧾</span> Orders</a>
    <div class="nav-section-label" style="margin-top:12px;">System</div>
    <a href="/" class="nav-link" target="_blank"><span class="nav-icon">🌐</span> Customer Portal</a>
    <a href="/admin/logout" class="nav-link"><span class="nav-icon">⏏</span> Logout</a>
  </nav>
  <div class="sidebar-footer">Sam's WiFi Admin</div>
</aside>

<!-- Main -->
<main class="admin-main">
  <div class="admin-topbar">
    <h1>🧾 Orders</h1>
    <button class="btn btn-primary btn-sm" onclick="openModal()">+ New Order</button>
  </div>

  <div class="admin-content">

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="padding:12px 16px;background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;margin-bottom:20px;">
        ⚠️ <%= error %>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div style="padding:12px 16px;background:rgba(74,222,128,0.12);border:1px solid rgba(74,222,128,0.3);color:#4ade80;border-radius:8px;margin-bottom:20px;">
        ✅ <%= success %>
      </div>
    <% } %>

    <!-- Stats -->
    <div class="grid-4" style="margin-bottom:24px;">
      <div class="stat-card" style="--stat-color:#fbbf24;">
        <div class="stat-icon">⏳</div>
        <div class="stat-label">Pending</div>
        <div class="stat-value"><%= counts.pending %></div>
        <div class="stat-sub">Awaiting payment</div>
      </div>
      <div class="stat-card" style="--stat-color:var(--success);">
        <div class="stat-icon">✅</div>
        <div class="stat-label">Paid Today</div>
        <div class="stat-value"><%= counts.paidToday %></div>
        <div class="stat-sub">Vouchers sent</div>
      </div>
      <div class="stat-card" style="--stat-color:var(--danger);">
        <div class="stat-icon">❌</div>
        <div class="stat-label">Cancelled</div>
        <div class="stat-value"><%= counts.cancelled %></div>
        <div class="stat-sub">All time</div>
      </div>
    </div>

    <!-- GCash reminder -->
    <div style="padding:14px 20px;background:rgba(0,212,255,0.07);border:1px solid rgba(0,212,255,0.2);border-radius:8px;margin-bottom:24px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
      <span style="font-size:1.3rem;">💙</span>
      <div>
        <div style="font-size:0.8rem;color:var(--gray-400);text-transform:uppercase;letter-spacing:0.08em;font-weight:600;">GCash Number</div>
        <div style="font-size:1.1rem;font-weight:800;font-family:var(--mono);color:var(--accent);">09985801867</div>
      </div>
      <div style="font-size:0.8rem;color:var(--gray-400);margin-left:auto;">Sam · Send payment here before marking paid</div>
    </div>

    <!-- Orders Table -->
    <div class="card" style="background:rgba(255,255,255,0.03);">
      <h3 style="margin-bottom:16px;">📋 All Orders</h3>

      <% if (!orders || orders.length === 0) { %>
        <p style="color:var(--gray-400);font-size:0.9rem;text-align:center;padding:32px 0;">No orders yet. Create one to get started.</p>
      <% } else { %>
        <div style="overflow-x:auto;">
          <table style="width:100%;font-size:0.85rem;border-collapse:collapse;">
            <thead>
              <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
                <th style="text-align:left;padding:10px 8px;color:var(--gray-400);font-weight:600;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.07em;">Customer</th>
                <th style="text-align:left;padding:10px 8px;color:var(--gray-400);font-weight:600;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.07em;">Contact</th>
                <th style="text-align:left;padding:10px 8px;color:var(--gray-400);font-weight:600;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.07em;">Plan</th>
                <th style="text-align:left;padding:10px 8px;color:var(--gray-400);font-weight:600;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.07em;">Price</th>
                <th style="text-align:left;padding:10px 8px;color:var(--gray-400);font-weight:600;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.07em;">Status</th>
                <th style="text-align:left;padding:10px 8px;color:var(--gray-400);font-weight:600;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.07em;">Age</th>
                <th style="text-align:right;padding:10px 8px;color:var(--gray-400);font-weight:600;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.07em;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(o => {
                const created = new Date(o.created_at);
                const ageMs = Date.now() - created.getTime();
                const ageMins = Math.floor(ageMs / 60000);
                const ageStr = ageMins < 60
                  ? ageMins + 'm ago'
                  : ageMins < 1440
                    ? Math.floor(ageMins/60) + 'h ago'
                    : Math.floor(ageMins/1440) + 'd ago';
              %>
              <tr style="border-bottom:1px solid rgba(255,255,255,0.05);" id="row-<%= o.id %>">
                <td style="padding:12px 8px;font-weight:600;color:var(--white);"><%= o.customer_name %></td>
                <td style="padding:12px 8px;color:var(--gray-400);font-family:var(--mono);font-size:0.8rem;"><%= o.customer_contact || '—' %></td>
                <td style="padding:12px 8px;color:var(--white);">
                  <%= o.pricing_tiers ? o.pricing_tiers.name : '—' %>
                </td>
                <td style="padding:12px 8px;font-weight:700;color:var(--accent);font-family:var(--mono);">
                  ₱<%= o.pricing_tiers ? o.pricing_tiers.price.toFixed(2) : '—' %>
                </td>
                <td style="padding:12px 8px;">
                  <% if (o.status === 'pending') { %>
                    <span style="padding:3px 10px;border-radius:100px;background:rgba(251,191,36,0.15);color:#fbbf24;font-size:0.75rem;font-weight:700;border:1px solid rgba(251,191,36,0.3);">PENDING</span>
                  <% } else if (o.status === 'paid') { %>
                    <span style="padding:3px 10px;border-radius:100px;background:rgba(74,222,128,0.12);color:#4ade80;font-size:0.75rem;font-weight:700;border:1px solid rgba(74,222,128,0.3);">PAID</span>
                  <% } else { %>
                    <span style="padding:3px 10px;border-radius:100px;background:rgba(255,255,255,0.06);color:var(--gray-400);font-size:0.75rem;font-weight:700;">CANCELLED</span>
                  <% } %>
                </td>
                <td style="padding:12px 8px;color:var(--gray-400);font-size:0.8rem;"><%= ageStr %></td>
                <td style="padding:12px 8px;text-align:right;">
                  <% if (o.status === 'pending') { %>
                    <button
                      onclick="markPaid('<%= o.id %>', '<%= o.customer_name.replace(/'/g, "\\'") %>')"
                      class="btn btn-success btn-sm"
                      style="margin-right:6px;">
                      ✅ Mark Paid
                    </button>
                    <form method="POST" action="/admin/orders/<%= o.id %>/cancel" style="display:inline;" onsubmit="return confirm('Cancel this order?')">
                      <button type="submit" class="btn btn-outline btn-sm" style="color:#fca5a5;border-color:rgba(239,68,68,0.3);">✕ Cancel</button>
                    </form>
                  <% } else if (o.status === 'paid' && o.voucher_token) { %>
                    <button onclick="showVoucher('<%= o.voucher_token %>', '<%= o.customer_name.replace(/'/g, "\\'") %>')" class="btn btn-outline btn-sm">
                      🔑 Show Code
                    </button>
                  <% } else { %>
                    <span style="color:var(--gray-400);font-size:0.8rem;">—</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>
</main>

<!-- New Order Modal -->
<div class="modal" id="newOrderModal">
  <div class="modal-content" style="max-width:460px;">
    <h3 style="margin-bottom:20px;">🧾 New Order</h3>
    <form method="POST" action="/admin/orders/create">
      <div class="form-group">
        <label style="display:block;font-size:0.75rem;color:var(--gray-400);margin-bottom:6px;text-transform:uppercase;letter-spacing:1px;">Customer Name *</label>
        <input type="text" name="customer_name" class="form-input" placeholder="e.g. Juan dela Cruz" required autofocus>
      </div>
      <div class="form-group">
        <label style="display:block;font-size:0.75rem;color:var(--gray-400);margin-bottom:6px;text-transform:uppercase;letter-spacing:1px;">Contact (optional)</label>
        <input type="text" name="customer_contact" class="form-input" placeholder="e.g. 09xxxxxxxxx">
      </div>
      <div class="form-group" style="margin-bottom:24px;">
        <label style="display:block;font-size:0.75rem;color:var(--gray-400);margin-bottom:6px;text-transform:uppercase;letter-spacing:1px;">Plan *</label>
        <select name="pricing_tier_id" class="form-input" required>
          <option value="">Select a plan...</option>
          <% pricingTiers.forEach(tier => { %>
            <% if (tier.price > 0) { %>
              <option value="<%= tier.id %>"><%= tier.name %> — ₱<%= tier.price.toFixed(2) %> / <%= tier.duration_minutes %> min</option>
            <% } %>
          <% }) %>
        </select>
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button type="button" onclick="closeModal()" class="btn btn-outline">Cancel</button>
        <button type="submit" class="btn btn-primary">Create Order</button>
      </div>
    </form>
  </div>
</div>

<!-- Voucher Success Modal -->
<div class="modal" id="voucherModal">
  <div class="modal-content" style="max-width:420px;text-align:center;">
    <div style="font-size:2.5rem;margin-bottom:8px;">🎉</div>
    <h3 style="margin-bottom:4px;" id="voucherModalTitle">Payment confirmed!</h3>
    <p id="voucherModalSub" style="color:var(--gray-400);font-size:0.85rem;margin-bottom:24px;"></p>

    <div style="background:rgba(0,212,255,0.08);border:2px dashed rgba(0,212,255,0.4);border-radius:10px;padding:20px 24px;margin-bottom:20px;">
      <div style="font-size:0.75rem;color:var(--gray-400);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px;">Voucher Code</div>
      <div id="voucherCodeDisplay" style="font-size:2rem;font-weight:900;font-family:var(--mono);color:var(--accent);letter-spacing:0.12em;"></div>
      <div style="font-size:0.75rem;color:var(--gray-400);margin-top:8px;" id="voucherPlanDisplay"></div>
    </div>

    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
      <button onclick="copyCode()" class="btn btn-primary">📋 Copy Code</button>
      <button onclick="closeVoucherModal()" class="btn btn-outline">Done</button>
    </div>

    <div id="copyMsg" style="font-size:0.8rem;color:#4ade80;margin-top:10px;display:none;">✅ Copied to clipboard!</div>
  </div>
</div>

<script>
  let currentVoucherCode = '';

  function openModal() {
    document.getElementById('newOrderModal').classList.add('open');
  }
  function closeModal() {
    document.getElementById('newOrderModal').classList.remove('open');
  }
  document.getElementById('newOrderModal').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
  });

  async function markPaid(orderId, customerName) {
    const btn = event.target;
    btn.disabled = true;
    btn.textContent = '⏳ Processing...';

    try {
      const res = await fetch(`/admin/orders/${orderId}/pay`, { method: 'POST' });
      const data = await res.json();

      if (data.success) {
        currentVoucherCode = data.voucher;
        document.getElementById('voucherModalTitle').textContent = `Payment confirmed!`;
        document.getElementById('voucherModalSub').textContent = `Copy this code and SMS it to ${data.customer}`;
        document.getElementById('voucherCodeDisplay').textContent = data.voucher;
        document.getElementById('voucherPlanDisplay').textContent = data.plan;
        document.getElementById('voucherModal').classList.add('open');

        // Update the row in place
        const row = document.getElementById(`row-${orderId}`);
        if (row) {
          // Reload to reflect new state cleanly
          setTimeout(() => location.reload(), 4000);
        }
      } else {
        alert('❌ ' + data.error);
        btn.disabled = false;
        btn.textContent = '✅ Mark Paid';
      }
    } catch (e) {
      alert('❌ ' + e.message);
      btn.disabled = false;
      btn.textContent = '✅ Mark Paid';
    }
  }

  function showVoucher(code, customer) {
    currentVoucherCode = code;
    document.getElementById('voucherModalTitle').textContent = 'Voucher Code';
    document.getElementById('voucherModalSub').textContent = `For ${customer}`;
    document.getElementById('voucherCodeDisplay').textContent = code;
    document.getElementById('voucherPlanDisplay').textContent = '';
    document.getElementById('voucherModal').classList.add('open');
  }

  function closeVoucherModal() {
    document.getElementById('voucherModal').classList.remove('open');
    document.getElementById('copyMsg').style.display = 'none';
  }
  document.getElementById('voucherModal').addEventListener('click', function(e) {
    if (e.target === this) closeVoucherModal();
  });

  async function copyCode() {
    try {
      await navigator.clipboard.writeText(currentVoucherCode);
      document.getElementById('copyMsg').style.display = 'block';
    } catch (e) {
      // Fallback
      const el = document.createElement('textarea');
      el.value = currentVoucherCode;
      document.body.appendChild(el);
      el.select();
      document.execCommand('copy');
      document.body.removeChild(el);
      document.getElementById('copyMsg').style.display = 'block';
    }
  }
</script>

</body>
</html>
