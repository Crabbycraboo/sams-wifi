<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <div class="brand-title"><span>Sam's</span> WiFi</div>
    <div class="brand-sub">Admin Panel</div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section-label">Main</div>
    <a href="/admin/dashboard" class="nav-link active"><span class="nav-icon">📊</span> Dashboard</a>
<a href="/admin/vouchers" class="nav-link"><span class="nav-icon">🎫</span> Vouchers</a>
    <div class="nav-section-label" style="margin-top:12px;">System</div>
    <a href="/" class="nav-link" target="_blank"><span class="nav-icon">🌐</span> Customer Portal</a>
    <a href="/admin/logout" class="nav-link"><span class="nav-icon">⏏</span> Logout</a>
  </nav>
  <div class="sidebar-footer">
    Sam's WiFi Admin
  </div>
</aside>

<main class="admin-main">
  <div class="admin-topbar">
    <h1>📊 Dashboard</h1>
    <button class="btn btn-outline btn-sm" onclick="location.reload()">🔄 Refresh</button>
  </div>

  <div class="admin-content">

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="padding:12px 16px;background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;margin-bottom:20px;">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div style="padding:12px 16px;background:rgba(74,222,128,0.12);border:1px solid rgba(74,222,128,0.3);color:#4ade80;border-radius:8px;margin-bottom:20px;">
        ✅ <%= success %>
      </div>
    <% } %>

    <!-- Sleep Mode Toggle -->
    <div style="margin-bottom:24px;padding:16px 20px;background:<%= (typeof settings !== 'undefined' && settings.sleep_mode === 'true') ? 'rgba(251,191,36,0.1)' : 'rgba(255,255,255,0.04)' %>;border:1px solid <%= (typeof settings !== 'undefined' && settings.sleep_mode === 'true') ? 'rgba(251,191,36,0.4)' : 'rgba(255,255,255,0.08)' %>;border-radius:8px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <div style="font-weight:700;font-size:0.95rem;">
          <%= (typeof settings !== 'undefined' && settings.sleep_mode === 'true') ? '😴 Sleep Mode ON' : '☀️ Sleep Mode OFF' %>
        </div>
        <div style="font-size:0.8rem;color:var(--gray-400);margin-top:2px;">
          <%= (typeof settings !== 'undefined' && settings.sleep_mode === 'true') ? 'Portal shows sleep message.' : 'All plans available to customers.' %>
        </div>
      </div>
      <button id="sleepBtn" onclick="toggleSetting('sleep_mode')" class="btn btn-outline" style="min-width:140px;">
        <%= (typeof settings !== 'undefined' && settings.sleep_mode === 'true') ? '☀️ Wake Up' : '😴 Sleep Mode' %>
      </button>
    </div>

    <!-- Stats -->
    <div class="grid-4" style="margin-bottom:24px;">
      <div class="stat-card" style="--stat-color:var(--success);">
        <div class="stat-icon">👥</div>
        <div class="stat-label">Active Sessions</div>
        <div class="stat-value"><%= (typeof activeSessions !== 'undefined' ? activeSessions.length : 0) %></div>
        <div class="stat-sub">Connected now</div>
      </div>
      <div class="stat-card" style="--stat-color:var(--accent);">
        <div class="stat-icon">🎫</div>
        <div class="stat-label">Unredeemed</div>
        <div class="stat-value"><%= (typeof voucherCounts !== 'undefined' ? voucherCounts.unredeemed : 0) %></div>
        <div class="stat-sub">Ready to sell</div>
      </div>
      <div class="stat-card" style="--stat-color:#667eea;">
        <div class="stat-icon">✅</div>
        <div class="stat-label">Used Vouchers</div>
        <div class="stat-value"><%= (typeof voucherCounts !== 'undefined' ? voucherCounts.active : 0) %></div>
        <div class="stat-sub">Active/redeemed</div>
      </div>
      <div class="stat-card" style="--stat-color:var(--gray-400);">
        <div class="stat-icon">⌛</div>
        <div class="stat-label">Expired</div>
        <div class="stat-value"><%= (typeof voucherCounts !== 'undefined' ? voucherCounts.expired : 0) %></div>
        <div class="stat-sub">All time</div>
      </div>
    </div>

    <!-- Generate Vouchers -->
    <div class="card" style="background:rgba(255,255,255,0.03);margin-bottom:24px;">
      <h3 style="margin-bottom:16px;">🎫 Generate Vouchers</h3>
      <form method="POST" action="/admin/vouchers/generate" style="display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;">
        <div style="flex:1;min-width:180px;">
          <label style="display:block;font-size:0.75rem;color:var(--gray-400);margin-bottom:6px;text-transform:uppercase;letter-spacing:1px;">Pricing Tier</label>
          <select name="tierId" class="form-input" style="padding:10px 12px;font-size:0.9rem;" required>
            <option value="">Select a plan...</option>
            <% if (typeof pricingTiers !== 'undefined') { pricingTiers.forEach(tier => { %>
              <option value="<%= tier.id %>"><%= tier.name %> (₱<%= tier.price %> / <%= tier.duration_minutes %> min)</option>
            <% }) } %>
          </select>
        </div>
        <div style="width:100px;">
          <label style="display:block;font-size:0.75rem;color:var(--gray-400);margin-bottom:6px;text-transform:uppercase;letter-spacing:1px;">Count</label>
          <input type="number" name="count" class="form-input" style="padding:10px 12px;font-size:0.9rem;" value="20" min="1" max="100" required>
        </div>
       <button type="submit" class="btn btn-primary" style="padding:10px 24px;">Generate</button>
        <a href="/admin/vouchers" class="btn btn-outline" style="padding:10px 24px;">View Vouchers</a>
      </form>
    </div>

    <!-- Active Sessions -->
    <div class="card" style="background:rgba(255,255,255,0.03);margin-bottom:24px;">
      <h3 style="margin-bottom:16px;">👥 Active Sessions</h3>
      <% if (typeof activeSessions === 'undefined' || activeSessions.length === 0) { %>
        <p style="color:var(--gray-400);font-size:0.9rem;text-align:center;padding:20px 0;">No active sessions right now</p>
      <% } else { %>
        <div style="overflow-x:auto;">
          <table style="width:100%;font-size:0.85rem;">
            <thead>
              <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
                <th style="text-align:left;padding:8px 0;color:var(--gray-400);">Voucher</th>
                <th style="text-align:left;padding:8px 0;color:var(--gray-400);">MAC Address</th>
                <th style="text-align:left;padding:8px 0;color:var(--gray-400);">IP</th>
                <th style="text-align:right;padding:8px 0;color:var(--gray-400);">Expires</th>
              </tr>
            </thead>
            <tbody>
              <% activeSessions.forEach(s => {
                const expires = s.vouchers ? new Date(s.vouchers.expires_at).toLocaleTimeString('en-PH') : 'N/A';
              %>
              <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
                <td style="padding:8px 0;color:#667eea;font-weight:600;font-family:var(--mono);font-size:0.8rem;"><%= s.voucher_token %></td>
                <td style="padding:8px 0;font-family:var(--mono);font-size:0.8rem;color:var(--gray-400);"><%= s.mac_address %></td>
                <td style="padding:8px 0;font-family:var(--mono);font-size:0.8rem;color:var(--gray-400);"><%= s.ip_address %></td>
                <td style="padding:8px 0;text-align:right;color:#4ade80;"><%= expires %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Recent Logs -->
    <div class="card" style="background:rgba(255,255,255,0.03);">
      <h3 style="margin-bottom:16px;">📋 Recent Activity</h3>
      <% if (typeof logs === 'undefined' || logs.length === 0) { %>
        <p style="color:var(--gray-400);font-size:0.9rem;text-align:center;padding:20px 0;">No activity yet</p>
      <% } else { %>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <% logs.forEach(log => { %>
          <div style="padding:10px;background:rgba(255,255,255,0.02);border-left:3px solid #667eea;border-radius:4px;">
            <div style="font-size:0.85rem;color:var(--white);"><%= log.description %></div>
            <div style="font-size:0.75rem;color:var(--gray-400);margin-top:4px;">
              <%= new Date(log.created_at).toLocaleString('en-PH') %>
              <% if (log.mac_address) { %> · <span style="font-family:var(--mono);"><%= log.mac_address %></span><% } %>
            </div>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>
</main>

<script>
async function toggleSetting(key) {
  const btn = document.getElementById('sleepBtn');
  const isOn = btn.textContent.includes('Wake Up');
  btn.disabled = true;
  btn.textContent = '⏳ Updating...';
  try {
    await fetch('/admin/settings/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `key=${key}&value=${!isOn}`
    });
    location.reload();
  } catch(e) {
    btn.disabled = false;
    btn.textContent = isOn ? '☀️ Wake Up' : '😴 Sleep Mode';
  }
}
</script>

</body>
</html>
